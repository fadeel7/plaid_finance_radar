# Leave these blank to run in demo mode (synthetic data, no account needed).
# To link a real Plaid sandbox account, create a free account at dashboard.plaid.com,
# grab your sandbox keys, and fill these in.

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PORT=5000

# Optional persistence. Leave DATABASE_URL blank to keep linked items in memory
# (demo mode). When set, linked Plaid items are stored in PostgreSQL with the
# access token encrypted at rest.
#   DATABASE_URL=postgresql://user:password@localhost:5432/finance_radar
DATABASE_URL=

# Key that encrypts access tokens at rest. Required only when DATABASE_URL is set.
# Generate one with:  python -m services.crypto
APP_ENCRYPTION_KEY=
